# circRNA Detection Pipeline
# Built on oxo-flow engine
#
# QUICK START:
#   1. Set reference_dir below to your genome directory
#   2. Place FASTQ files in raw/
#   3. oxo-flow run circrna.oxoflow -j 16
#
# Indexes are auto-built on first run. Environments are auto-created.

[workflow]
name = "circrna"
version = "1.0.0"
description = "circRNA detection and analysis pipeline"
author = "oxo-flow-circrna"
format_version = "1.0"
sample_pattern = "raw/{sample}_1.fastq.gz"

[config]
# Engine-injected at run time from the sample_pattern discovery; declared here
# so `validate` passes on a fresh clone (the injected list wins at run time).
samples_list = ""
# === The only path you need to set ===
# reference_dir/ layout: genome.fa, genes.gtf, hg38_ref.txt,
#   bwa/genome.fa.{bwt,pac,ann,amb,sa}, hisat2/genome.fa.{1-8}.ht2,
#   bowtie2/genome.fa.*.bt2, star/
reference_dir = "./reference"

# Optional: files outside the default layout. Uncomment and set concrete paths
# (relative or absolute); each overrides the auto-derived value for that file.
# reference_fasta = "/path/genome.fa"
# gene_annotation = "/path/genes.gtf"
# bwa_index = "/path/bwa/genome.fa"
# hisat2_index = "/path/hisat2/genome.fa"
# bowtie2_index = "/path/bowtie2/genome.fa"
# star_index = "/path/star"

[defaults]
threads = 8
memory = "16G"

# === Indexes: existing files reused, missing auto-built ===
[[references]]
name = "bowtie2_index"
output = "{config.bowtie2_index}.1.bt2"
build = "mkdir -p $(dirname {config.bowtie2_index}) && bowtie2-build --threads 8 {config.reference_fasta} {config.bowtie2_index}"
threads = 8
memory = "16G"
description = "Bowtie2 index used by find_circ"

[references.environment]
conda = "envs/circrna_finder.yaml"

[[references]]
name = "star_index"
output = "{config.star_index}/SAindex"
build = "mkdir -p {config.star_index} && STAR --runMode genomeGenerate --genomeDir {config.star_index} --genomeFastaFiles {config.reference_fasta} --sjdbGTFfile {config.gene_annotation} --runThreadN 16"
threads = 8
memory = "16G"
description = "STAR index used by circRNA_finder"

[references.environment]
conda = "envs/circrna_finder.yaml"

[[references]]
name = "bwa_index"
output = "{config.bwa_index}.bwt"
build = "mkdir -p $(dirname {config.bwa_index}) && bwa index -p {config.bwa_index} {config.reference_fasta}"
threads = 8
memory = "16G"
description = "BWA index used by CIRIquant"

[references.environment]
conda = "envs/ciriquant.yaml"

[[references]]
name = "hisat2_index"
output = "{config.hisat2_index}.1.ht2"
build = "mkdir -p $(dirname {config.hisat2_index}) && hisat2-build -p 8 {config.reference_fasta} {config.hisat2_index}"
threads = 8
memory = "16G"
description = "HISAT2 index used by CIRIquant"

[references.environment]
conda = "envs/ciriquant.yaml"

# === Sub-workflows ===
[[include]]
path = "rules/qc.oxoflow"

[[include]]
path = "rules/callers.oxoflow"

[[include]]
path = "rules/annotation.oxoflow"

[[include]]
path = "rules/aggregation.oxoflow"

[[include]]
path = "rules/report.oxoflow"
