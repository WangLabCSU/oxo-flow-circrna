# Aggregation Module - Ensemble circRNA calls
# Merges results from available detection methods (2+ required)

[workflow]
name = "aggregation"
version = "1.0.0"

# === Aggregate circRNAs per sample ===
# Tolerates missing caller outputs — runs with 2+ of 4 methods available.
[[rules]]
name = "aggregate"
input = [
    "results/{sample}.CIRI.bed",
    "results/{sample}.circexplorer2.bed",
    "results/{sample}.find_circ.bed",
    "results/{sample}.circRNA_finder.bed",
    "{config.gene_annotation}",
    "scripts/aggregate_beds.R",
    "scripts/common.py"
]
output = ["results/{sample}.aggr.txt"]
threads = 2
memory = "8G"
description = "Aggregate circRNA calls (works with 2+ methods)"
shell = """
Rscript scripts/aggregate_beds.R results results {config.gene_annotation} scripts/common.py {sample} 2>&1 | tee results/{sample}_aggregate.log
if [ ! -f {output[0]} ]; then
    echo "No circRNAs detected for {sample}" > {output[0]}
fi
"""

[rules.environment]
conda = "envs/annotation.yaml"

# === Aggregate across all samples ===
[[rules]]
name = "aggregate_dataset"
input = ["results/*.aggr.txt", "scripts/aggregate_dataset.R"]
output = ["results/results_circRNA.tsv.gz"]
depends_on = ["aggregate"]
threads = 2
memory = "8G"
description = "Aggregate circRNAs across all samples"
shell = """
Rscript scripts/aggregate_dataset.R results results {config.samples_list} 2>&1 | tee results/dataset_aggregate.log
"""

[rules.environment]
conda = "envs/annotation.yaml"
