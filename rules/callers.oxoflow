# Callers Module - circRNA detection methods
# Four complementary methods: CIRIquant, CIRCexplorer2, find_circ, circRNA_finder

[workflow]
name = "callers"
version = "1.0.0"

# === CIRIquant: Alignment-based circRNA detection ===
[[rules]]
name = "ciriquant"
input = ["trimmed/{sample}_1.fastq.gz", "trimmed/{sample}_2.fastq.gz", "{config.reference_fasta}", "{config.gene_annotation}"]
output = ["results/{sample}.CIRI.bed"]
depends_on = ["fastp"]
threads = 8
memory = "32G"
# bounded fail-fast: CIRIquant's error path can leave orphaned
# subprocesses hanging forever (live: 'index does not exist' left two
# hisat2 processes parked at 0% CPU for 40+ min) — the engine kills
# the whole process group at the limit.
time_limit = "2h"
description = "CIRIquant circRNA detection"
shell = """
mkdir -p results/{sample}.CIRI

BWA=$(command -v bwa) || exit 1
HISAT2=$(command -v hisat2) || exit 1
STRINGTIE=$(command -v stringtie) || exit 1
SAMTOOLS=$(command -v samtools) || exit 1
cat > results/{sample}.CIRI/ciriquant.yml <<EOF
name: hg38

tools:
  bwa: $BWA
  hisat2: $HISAT2
  stringtie: $STRINGTIE
  samtools: $SAMTOOLS

reference:
  fasta: {config.reference_fasta}
  gtf: {config.gene_annotation}
  bwa_index: {config.bwa_index}
  hisat_index: {config.hisat2_index}
EOF

# stdin is /dev/null so CIRIquant's hisat2 subprocesses cannot hang on
# the engine's open stdin pipe when the tool's error path leaves them
# orphaned (live: 'index does not exist' parked two hisat2 processes
# reading the rule's stdin for 40+ min).
CIRIquant -t {threads} \
    -1 {input[0]} -2 {input[1]} \
    --config results/{sample}.CIRI/ciriquant.yml \
    --no-gene \
    -o results/{sample}.CIRI -p {sample} -v < /dev/null

if [ -f results/{sample}.CIRI/{sample}.gtf ]; then
    grep -v "#" results/{sample}.CIRI/{sample}.gtf | awk '{print $14}' | cut -d '.' -f1 > results/{sample}.CIRI/{sample}.counts
    grep -v "#" results/{sample}.CIRI/{sample}.gtf | awk -v OFS="\\t" '{gsub(/[";]/, "", $20); gsub(/[";]/, "", $22); print $1,$4-1,$5,$7,$20,$22}' > results/{sample}.CIRI/{sample}.tmp
    paste results/{sample}.CIRI/{sample}.tmp results/{sample}.CIRI/{sample}.counts > {output[0]}
    rm -f results/{sample}.CIRI/{sample}.tmp results/{sample}.CIRI/{sample}.counts
fi
if [ ! -f {output[0]} ]; then
    echo "WARNING: {output[0]} not created — caller may have failed" >&2
    # Zero junctions is a valid biological result (upstream's channel
    # just continues empty); the aggregate skips zero-size caller beds
    # (size > 0 filter) and works with the remaining methods.
    touch {output[0]}
fi
rm -rf results/{sample}.CIRI/align results/{sample}.CIRI/circ 2>/dev/null || true
"""

[rules.environment]
conda = "envs/ciriquant.yaml"

# === CIRCexplorer2: Junction-based circRNA detection ===
[[rules]]
name = "circexplorer2"
input = ["trimmed/{sample}_1.fastq.gz", "trimmed/{sample}_2.fastq.gz", "{config.reference_dir}/hg38_ref.txt", "{config.reference_fasta}"]
output = ["results/{sample}.circexplorer2.bed"]
depends_on = ["fastp"]
threads = 8
memory = "16G"
description = "CIRCexplorer2 circRNA detection"
shell = """
mkdir -p results/{sample}.circexplorer2

bwa mem -t {threads} -T 19 {config.bwa_index} {input[0]} {input[1]} \
    > results/{sample}.circexplorer2/{sample}_unmapped_bwa.sam 2> results/{sample}.circexplorer2/{sample}_bwa.log

CIRCexplorer2 parse -t BWA -b results/{sample}.circexplorer2/{sample}_circ2_result.txt results/{sample}.circexplorer2/{sample}_unmapped_bwa.sam \
    > results/{sample}.circexplorer2/{sample}_parse.log 2>&1

CIRCexplorer2 annotate -r {config.reference_dir}/hg38_ref.txt -g {config.reference_fasta} \
    -b results/{sample}.circexplorer2/{sample}_circ2_result.txt -o results/{sample}.circexplorer2/{sample}_circ2_result_ann.txt

if [ -f results/{sample}.circexplorer2/{sample}_circ2_result_ann.txt ]; then
    awk -v OFS="\\t" 'NR>1 {print $1,$2,$3,$6,$13}' results/{sample}.circexplorer2/{sample}_circ2_result_ann.txt > {output[0]}
fi
if [ ! -f {output[0]} ]; then echo "WARNING: {output[0]} not created — caller may have failed" >&2; fi
rm -f results/{sample}.circexplorer2/*.sam
"""

[rules.environment]
conda = "envs/circexplorer2.yaml"

# === find_circ: Anchor-based circRNA detection ===
[[rules]]
name = "find_circ"
input = ["trimmed/{sample}_1.fastq.gz", "trimmed/{sample}_2.fastq.gz", "{config.reference_fasta}"]
output = ["results/{sample}.find_circ.bed"]
depends_on = ["fastp"]
threads = 8
memory = "16G"
description = "find_circ circRNA detection"
shell = """
mkdir -p results/{sample}.find_circ

bowtie2 -x {config.bowtie2_index} \
    -1 {input[0]} -2 {input[1]} \
    --threads {threads} \
    --very-sensitive --score-min=C,-15,0 --reorder --mm \
    2> results/{sample}.find_circ/{sample}.bowtie2.log | samtools sort -@ {threads} -o results/{sample}.find_circ/{sample}.bam -
samtools index -@ {threads} results/{sample}.find_circ/{sample}.bam

samtools view -@ {threads} -hbf 4 results/{sample}.find_circ/{sample}.bam > results/{sample}.find_circ/{sample}.unmapped.bam
samtools index -@ {threads} results/{sample}.find_circ/{sample}.unmapped.bam

unmapped2anchors.py results/{sample}.find_circ/{sample}.unmapped.bam > results/{sample}.find_circ/{sample}.unmapped.fastq

bowtie2 -q -U results/{sample}.find_circ/{sample}.unmapped.fastq -x {config.bowtie2_index} \
    --threads {threads} --reorder --mm --very-sensitive --score-min=C,-15,0 \
    2> results/{sample}.find_circ/{sample}.bowtie2.2nd.log | \
    find_circ.py -G {config.reference_fasta} -n {sample} \
    --stats results/{sample}.find_circ/{sample}.sites.log --reads results/{sample}.find_circ/{sample}.spliced_reads.fa \
    > results/{sample}.find_circ/{sample}.splice_sites.bed

if [ -f results/{sample}.find_circ/{sample}.splice_sites.bed ]; then
    grep CIRCULAR results/{sample}.find_circ/{sample}.splice_sites.bed | grep -v chrM | \
        grep UNAMBIGUOUS_BP | grep ANCHOR_UNIQUE | \
        maxlength.py 100000 > results/{sample}.find_circ/{sample}.filtered.txt
    if [ -s results/{sample}.find_circ/{sample}.filtered.txt ]; then
        awk -v OFS="\\t" '{print $1,$2,$3,$6,$5,$4}' results/{sample}.find_circ/{sample}.filtered.txt > {output[0]}
    fi
fi
if [ ! -f {output[0]} ]; then echo "WARNING: {output[0]} not created — caller may have failed" >&2; fi
rm -f results/{sample}.find_circ/*.bam results/{sample}.find_circ/*.bai results/{sample}.find_circ/*.fastq results/{sample}.find_circ/*.fa
"""

[rules.environment]
conda = "envs/findcirc.yaml"

# === circRNA_finder: Chimeric read detection with STAR ===
[[rules]]
name = "circrna_finder"
input = ["trimmed/{sample}_1.fastq.gz", "trimmed/{sample}_2.fastq.gz"]
output = ["results/{sample}.circRNA_finder.bed"]
depends_on = ["fastp"]
threads = 8
memory = "32G"
description = "circRNA_finder detection with STAR"
shell = """
mkdir -p results/{sample}.circRNA_finder

STAR --readFilesIn {input[0]} {input[1]} \
    --runThreadN {threads} \
    --genomeDir {config.star_index} \
    --chimSegmentMin 20 --chimScoreMin 1 --alignIntronMax 100000 \
    --chimOutType Junctions SeparateSAMold \
    --outFilterMismatchNmax 4 \
    --alignTranscriptsPerReadNmax 100000 \
    --outFilterMultimapNmax 2 \
    --outFileNamePrefix results/{sample}.circRNA_finder/{sample}. \
    --readFilesCommand zcat \
    --outStd Log --outSAMtype BAM Unsorted

if [ -f results/{sample}.circRNA_finder/{sample}.Chimeric.out.junction ]; then
    postProcessStarAlignment.pl --starDir results/{sample}.circRNA_finder/ --outDir results/{sample}.circRNA_finder/
fi

if [ -f results/{sample}.circRNA_finder/{sample}.filteredJunctions.bed ]; then
    awk -v OFS="\\t" -F"\\t" '{print $1,$2,$3,$6,$5}' \
        results/{sample}.circRNA_finder/{sample}.filteredJunctions.bed > {output[0]}
fi
if [ ! -f {output[0]} ]; then echo "WARNING: {output[0]} not created — caller may have failed" >&2; fi
rm -f results/{sample}.circRNA_finder/*.sam results/{sample}.circRNA_finder/*.bam results/{sample}.circRNA_finder/*.bai 2>/dev/null || true
"""

[rules.environment]
conda = "envs/circrna_finder.yaml"
